---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ubicacion from '../components/Ubicacion.astro';
import Footer from '../components/Footer.astro';
import NuestraHistoria from '../components/NuestraHistoria.astro';
import Products from '../components/Products.astro';
import Consultas from '../components/Consultas.astro';
import Carrito from '../components/Carrito.astro';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Con Amore | Pastelería Artesanal</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  </head>
  <body class="font-sans bg-[#FFF5F8] text-gray-800 relative">

    <Header />
    <Hero />
    <NuestraHistoria />
    <Products />
    <Consultas />
    <Ubicacion />
    <Footer />
    <Carrito />

  </body>
</html>