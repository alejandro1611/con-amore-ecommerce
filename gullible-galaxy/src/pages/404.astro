---
// src/pages/404.astro
// Astro sirve este archivo automáticamente cuando la URL no coincide con ninguna ruta.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Página no encontrada | Con Amore</title>
    <link rel="icon" type="image/x-icon" href="/con-amore-logo.ico?v=123" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  </head>
  <body class="font-sans bg-[#FFF5F8] text-gray-800 relative flex flex-col min-h-screen">

    <Header />

    <main class="flex-grow flex flex-col items-center justify-center text-center px-6 py-24">
      <p class="text-8xl md:text-9xl font-serif font-bold text-[#E21A77] mb-4">404</p>
      <h1 class="text-2xl md:text-3xl font-serif font-bold text-gray-900 mb-4">
        Esta página se nos quemó en el horno
      </h1>
      <p class="text-gray-600 max-w-md mb-10 leading-relaxed">
        No encontramos lo que estás buscando. Puede que el enlace esté roto o
        que la página se haya movido.
      </p>
      <a
        href="/"
        class="bg-[#D4AF37] text-white px-6 py-3 rounded font-semibold hover:bg-[#B8972E] transition"
      >
        Volver al inicio
      </a>
    </main>

    <Footer />

  </body>
</html>