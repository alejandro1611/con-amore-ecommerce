---
// Carrito.astro
// Panel del carrito + overlay + modal de confirmación para "Vaciar".
// Toda la lógica de estado (agregar, sumar, restar, eliminar, vaciar, WhatsApp) vive acá.
const numeroWhatsApp = "+5493886061238";
---

<!-- Panel del Carrito -->
<div id="panel-carrito" class="fixed inset-y-0 right-0 w-full md:w-96 bg-white shadow-2xl transform translate-x-full transition-transform duration-300 z-50 flex flex-col">
  <div class="p-6 bg-[#E21A77] text-white flex justify-between items-center">
    <h3 class="text-xl font-bold font-serif">Tu Pedido</h3>
    <div class="flex items-center gap-3">
      <button id="btn-vaciar-carrito" class="text-xs font-semibold uppercase tracking-wide border border-white/60 rounded-full px-3 py-1 hover:bg-white/10 transition">
        Vaciar
      </button>
      <button id="btn-cerrar-carrito" class="text-3xl leading-none" aria-label="Cerrar carrito">&times;</button>
    </div>
  </div>

  <div id="lista-carrito" class="flex-grow p-6 overflow-y-auto flex flex-col gap-4">
    <p class="text-gray-500 text-center mt-10">El carrito está vacío</p>
  </div>

  <div class="p-6 border-t bg-gray-50 flex flex-col gap-3">
    <!-- Formulario de validación rápida -->
    <div class="flex flex-col gap-3 mb-4 mt-2">
      <div class="relative">
        <input type="text" id="input-nombre" placeholder="Tu nombre..." class="w-full bg-white border border-gray-200 text-gray-800 text-sm rounded-xl px-4 py-3 outline-none transition-all duration-200 focus:border-[#E21A77] focus:ring-4 focus:ring-[#E21A77]/10 shadow-sm placeholder-gray-400" required />
      </div>
      
      <div class="relative">
        <select id="select-envio" class="w-full bg-white border border-gray-200 text-gray-800 text-sm rounded-xl px-4 py-3 outline-none transition-all duration-200 focus:border-[#E21A77] focus:ring-4 focus:ring-[#E21A77]/10 shadow-sm appearance-none cursor-pointer" required>
          <option value="" disabled selected>Seleccioná método de entrega...</option>
          <option value="Retiro en local">Retiro en local</option>
          <option value="Envío a domicilio">Envío a domicilio</option>
        </select>
        <!-- Ícono de flechita personalizado -->
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-400">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </div>
      </div>

      <div class="relative">
        <textarea id="input-notas" placeholder="Notas (ej: sin azúcar, alérgico a nueces)..." class="w-full bg-white border border-gray-200 text-gray-800 text-sm rounded-xl px-4 py-3 outline-none transition-all duration-200 focus:border-[#E21A77] focus:ring-4 focus:ring-[#E21A77]/10 shadow-sm placeholder-gray-400 resize-none h-20" spellcheck="false"></textarea>
      </div>
    </div>

    <div class="flex justify-between text-xl font-bold mb-2 text-gray-800">
      <span>Total:</span>
      <span id="total-carrito">$0</span>
    </div>
    
    <button id="btn-whatsapp" class="w-full bg-[#25D366] text-white py-4 rounded-lg font-bold text-lg hover:bg-[#1DA851] transition flex justify-center items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor">
        <path d="M20.52 3.48A11.9 11.9 0 0 0 12.04 0C5.5 0 .16 5.34.16 11.88c0 2.1.55 4.14 1.6 5.94L0 24l6.33-1.66a11.86 11.86 0 0 0 5.7 1.45h.01c6.54 0 11.88-5.34 11.88-11.88 0-3.17-1.24-6.15-3.4-8.43zM12.04 21.6c-1.78 0-3.52-.48-5.04-1.38l-.36-.21-3.76.99 1-3.67-.24-.38a9.7 9.7 0 0 1-1.48-5.07c0-5.36 4.36-9.72 9.9-9.72 2.64 0 5.12 1.03 6.98 2.9a9.78 9.78 0 0 1 2.9 6.96c0 5.36-4.37 9.72-9.9 9.72zm5.44-7.28c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.24-.46-2.37-1.47-.87-.78-1.46-1.74-1.63-2.04-.17-.3-.02-.46.13-.6.13-.13.3-.35.44-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.09 3.2 5.08 4.48.71.31 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35z"/>
      </svg>
      Enviar a WhatsApp
    </button>
  </div>
</div>

<!-- Fondo oscuro carrito -->
<div id="overlay" class="fixed inset-0 bg-black/50 hidden z-40"></div>

<!-- Modal de confirmación: Vaciar carrito -->
<div id="modal-vaciar" class="fixed inset-0 z-[60] hidden items-center justify-center p-6">
  <div id="modal-vaciar-backdrop" class="absolute inset-0 bg-black/50"></div>
  <div class="relative bg-white rounded-xl shadow-xl max-w-sm w-full p-6">
    <h4 class="text-lg font-bold text-gray-900 mb-2">Vaciar carrito</h4>
    <p class="text-sm text-gray-600 mb-6">¿Estás de acuerdo en quitar todos los productos del carrito?</p>
    <div class="flex gap-3">
      <button id="btn-cancelar-vaciar" class="flex-1 border border-gray-300 text-gray-700 rounded-lg py-2 font-semibold hover:bg-gray-50 transition">
        Mejor no, gracias
      </button>
      <button id="btn-confirmar-vaciar" class="flex-1 bg-[#E21A77] text-white rounded-lg py-2 font-semibold hover:bg-[#C71568] transition">
        Sí, vaciar carrito
      </button>
    </div>
  </div>
</div>

<!-- Modal de Validación Personalizado -->
<div id="modal-validacion" class="fixed inset-0 z-[70] hidden items-center justify-center p-6 opacity-0 transition-opacity duration-300">
  <div id="modal-validacion-backdrop" class="absolute inset-0 bg-black/50 cursor-pointer"></div>
  <div class="relative bg-white rounded-xl shadow-2xl max-w-sm w-full p-6 text-center transform scale-95 transition-transform duration-300">
    <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center mx-auto mb-4">
      <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
      </svg>
    </div>
    <h4 class="text-lg font-bold text-gray-900 mb-2">Faltan datos</h4>
    <p id="texto-modal-validacion" class="text-sm text-gray-600 mb-6">Por favor, ingresá tu nombre y seleccioná el método de entrega antes de enviar el pedido.</p>
    <button id="btn-cerrar-validacion" class="w-full bg-[#E21A77] text-white rounded-lg py-3 font-bold hover:bg-[#C71568] transition">
      Entendido
    </button>
  </div>
</div>

<script>
   const modalValidacion = document.getElementById('modal-validacion');
  const btnCerrarValidacion = document.getElementById('btn-cerrar-validacion');
  const backdropValidacion = document.getElementById('modal-validacion-backdrop');

  function abrirModalValidacion() {
    modalValidacion?.classList.remove('hidden');
    modalValidacion?.classList.add('flex');
    setTimeout(() => {
      modalValidacion?.classList.remove('opacity-0');
      modalValidacion?.querySelector('.relative')?.classList.remove('scale-95');
    }, 10);
  }

  function cerrarModalValidacion() {
    modalValidacion?.classList.add('opacity-0');
    modalValidacion?.querySelector('.relative')?.classList.add('scale-95');
    setTimeout(() => {
      modalValidacion?.classList.add('hidden');
      modalValidacion?.classList.remove('flex');
    }, 300); // Espera a que termine la animación
  }

  // Eventos para cerrar el modal clickeando el botón o el fondo oscuro
  btnCerrarValidacion?.addEventListener('click', cerrarModalValidacion);
  backdropValidacion?.addEventListener('click', cerrarModalValidacion);
  type Producto = { id: string; nombre: string; precio: number; cantidad: number };
  const CLAVE_STORAGE = 'con-amore-carrito';

  function cargarCarritoGuardado(): Producto[] {
    try {
      const guardado = localStorage.getItem(CLAVE_STORAGE);
      return guardado ? JSON.parse(guardado) : [];
    } catch {
      // Si el dato guardado está corrupto o localStorage no está disponible
      // (ej. modo incógnito con restricciones), arrancamos con carrito vacío.
      return [];
    }
  }

  let carrito: Producto[] = cargarCarritoGuardado();
  const numeroWhatsApp = "+5493886061238"; // mismo número que en Consultas.astro

  const panelCarrito = document.getElementById('panel-carrito');
  const overlay = document.getElementById('overlay');
  const listaCarrito = document.getElementById('lista-carrito');
  const contadorCarritoNav = document.getElementById('contador-carrito-nav');
  const totalCarrito = document.getElementById('total-carrito');
  const btnWhatsapp = document.getElementById('btn-whatsapp') as HTMLButtonElement | null;
  const modalVaciar = document.getElementById('modal-vaciar');

  document.getElementById('btn-abrir-carrito')?.addEventListener('click', abrirCarrito);
  document.getElementById('btn-cerrar-carrito')?.addEventListener('click', cerrarCarrito);
  overlay?.addEventListener('click', cerrarCarrito);

  function abrirCarrito() {
    panelCarrito?.classList.remove('translate-x-full');
    overlay?.classList.remove('hidden');
  }

  function cerrarCarrito() {
    panelCarrito?.classList.add('translate-x-full');
    overlay?.classList.add('hidden');
  }

  // Agregar producto desde las cards del catálogo (index.astro).
  // No abre el panel: solo actualiza el contador del nav.
  document.querySelectorAll('.btn-agregar').forEach(boton => {
    boton.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLElement;
      const id = target.getAttribute('data-id')!;
      const nombre = target.getAttribute('data-nombre')!;
      const precio = parseInt(target.getAttribute('data-precio')!);
      const productoExistente = carrito.find(item => item.id === id);
      if (productoExistente) productoExistente.cantidad += 1;
      else carrito.push({ id, nombre, precio, cantidad: 1 });

      actualizarCarrito();
    });
  });

  // Delegación de eventos para +/- y eliminar (los botones se generan dinámicamente)
  listaCarrito?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest('[data-accion]') as HTMLElement | null;
    if (!btn) return;

    const id = btn.getAttribute('data-id')!;
    const accion = btn.getAttribute('data-accion');
    const item = carrito.find(p => p.id === id);
    if (!item) return;

    if (accion === 'sumar') {
      item.cantidad += 1;
    } else if (accion === 'restar') {
      // El botón "-" viene deshabilitado cuando cantidad === 1, así que acá
      // siempre baja de 2 en adelante.
      item.cantidad -= 1;
    } else if (accion === 'eliminar') {
      carrito = carrito.filter(p => p.id !== id);
    }

    actualizarCarrito();
  });

  // --- Botón "Vaciar" + modal de confirmación ---
  document.getElementById('btn-vaciar-carrito')?.addEventListener('click', () => {
    if (carrito.length === 0) return;
    modalVaciar?.classList.remove('hidden');
    modalVaciar?.classList.add('flex');
  });

  document.getElementById('btn-cancelar-vaciar')?.addEventListener('click', cerrarModalVaciar);
  document.getElementById('modal-vaciar-backdrop')?.addEventListener('click', cerrarModalVaciar);

  function cerrarModalVaciar() {
    modalVaciar?.classList.add('hidden');
    modalVaciar?.classList.remove('flex');
  }

  document.getElementById('btn-confirmar-vaciar')?.addEventListener('click', () => {
    carrito = [];
    actualizarCarrito();
    cerrarModalVaciar();
  });

  function actualizarCarrito() {
    // Guardamos siempre, incluso con el carrito vacío (si no, "Vaciar" o
    // sacar el último producto no se reflejaría después de refrescar).
    try {
      localStorage.setItem(CLAVE_STORAGE, JSON.stringify(carrito));
    } catch {
      // Si localStorage no está disponible, seguimos igual: el carrito
      // funciona en memoria, solo no persiste entre refrescos.
    }

    if (contadorCarritoNav) {
      contadorCarritoNav.innerText = String(carrito.reduce((acc, item) => acc + item.cantidad, 0));
    }

    if (carrito.length === 0) {
      if (listaCarrito) listaCarrito.innerHTML = '<p class="text-gray-500 text-center mt-10">El carrito está vacío</p>';
      if (totalCarrito) totalCarrito.innerText = "$0";
      if (btnWhatsapp) btnWhatsapp.disabled = true;
      return;
    }

    let total = 0;
    if (listaCarrito) {
      listaCarrito.innerHTML = carrito.map(item => {
        total += item.precio * item.cantidad;
        const restarDeshabilitado = item.cantidad === 1;
        return `
          <div class="flex justify-between items-start border-b pb-3">
            <div class="flex-grow">
              <p class="font-bold text-sm">${item.nombre}</p>
              <p class="text-sm text-gray-500">$${item.precio} c/u</p>
              <div class="flex items-center gap-2 mt-2">
                <button
                  data-accion="eliminar"
                  data-id="${item.id}"
                  aria-label="Quitar producto"
                  class="w-8 h-8 flex items-center justify-center rounded-full border border-red-200 text-red-500 hover:bg-red-50 transition"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 6h18"></path>
                    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                  </svg>
                </button>
                <div class="flex items-center gap-2 border border-gray-300 rounded-full px-1">
                  <button
                    data-accion="restar"
                    data-id="${item.id}"
                    ${restarDeshabilitado ? 'disabled' : ''}
                    class="w-7 h-7 flex items-center justify-center rounded-full text-gray-600 hover:bg-gray-100 transition disabled:opacity-30 disabled:cursor-default disabled:hover:bg-transparent"
                  >−</button>
                  <span class="w-6 text-center font-semibold text-sm">${item.cantidad}</span>
                  <button
                    data-accion="sumar"
                    data-id="${item.id}"
                    class="w-7 h-7 flex items-center justify-center rounded-full text-gray-600 hover:bg-gray-100 transition"
                  >+</button>
                </div>
              </div>
            </div>
            <p class="font-bold text-[#E21A77] whitespace-nowrap ml-3">$${item.precio * item.cantidad}</p>
          </div>
        `;
      }).join('');
    }

    if (totalCarrito) totalCarrito.innerText = `$${total}`;
    if (btnWhatsapp) btnWhatsapp.disabled = false;
  }

  // Forzar primera letra en mayúscula en tiempo real
  const inputNombreGral = document.getElementById('input-nombre') as HTMLInputElement | null;
  inputNombreGral?.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    if (target.value.length > 0) {
      // Toma la primera letra, la hace mayúscula y le pega el resto del texto
      target.value = target.value.charAt(0).toUpperCase() + target.value.slice(1);
    }
  });

  // Arma el mensaje del pedido y lo manda a WhatsApp
  btnWhatsapp?.addEventListener('click', () => {
    if (carrito.length === 0) return;

    // 1. Obtener valores del formulario
    const inputNombre = document.getElementById('input-nombre') as HTMLInputElement | null;
    const selectEnvio = document.getElementById('select-envio') as HTMLSelectElement | null;
    const inputNotas = document.getElementById('input-notas') as HTMLTextAreaElement | null;

    const nombre = inputNombre?.value.trim() || '';
    const envio = selectEnvio?.value || '';
    const notas = inputNotas?.value.trim() || '';

    // 2. Validación obligatoria
    const textoModal = document.getElementById('texto-modal-validacion');

    // 2. Validación obligatoria (vacíos)
    if (!nombre || !envio) {
      if (textoModal) textoModal.innerText = "Por favor, ingresá tu nombre y seleccioná el método de entrega antes de enviar el pedido.";
      abrirModalValidacion();
      return;
    }

    // 2.1 Validación de longitud del nombre (mínimo 3 caracteres)
    if (nombre.length < 3) {
      if (textoModal) textoModal.innerText = "El nombre es muy corto. Por favor, escribí al menos 3 letras para identificar tu pedido.";
      abrirModalValidacion();
      return;
    }

    // 3. Armar lista de productos y calcular total
    let total = 0;
    let listaProductos = "";

    carrito.forEach(item => {
      const subtotal = item.precio * item.cantidad;
      total += subtotal;
      // Codificamos solo el nombre del producto por si tiene tildes o símbolos
      listaProductos += `• ${item.cantidad}x ${encodeURIComponent(item.nombre)} ($${item.precio} c/u)%0A`;
    });

    // 4. Construir el mensaje usando %0A directo para garantizar los saltos de línea
    let mensajeFinal = `*¡Hola! Quiero realizar un pedido:*%0A`;
    mensajeFinal += `------------------------------------%0A`;
    mensajeFinal += listaProductos;
    mensajeFinal += `------------------------------------%0A`;
    mensajeFinal += `*Total:* $${total}%0A`;
    mensajeFinal += `*Nombre:* ${encodeURIComponent(nombre)}%0A`;
    mensajeFinal += `*Método:* ${encodeURIComponent(envio)}`;
    
    if (notas) {
      mensajeFinal += `%0A*Notas:* ${encodeURIComponent(notas)}`;
    }

    // 5. Enviar a WhatsApp
    const numeroLimpio = numeroWhatsApp.replace(/\D/g, '');
    const url = `https://wa.me/${numeroLimpio}?text=${mensajeFinal}`;
    
    window.open(url, '_blank');
  });

  // Estado inicial: si había algo guardado en localStorage, se renderiza acá.
  actualizarCarrito();
</script>