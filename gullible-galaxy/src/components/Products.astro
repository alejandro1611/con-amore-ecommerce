---
import { sanityClient } from '../lib/sanity.js';

// Actualizamos la consulta para traer el slug y el booleano isAvailable
const productos = await sanityClient.fetch(`
  *[_type == "product"]{
    "id": _id,
    "nombre": name,
    "slug": slug.current,
    "isAvailable": isAvailable,
    "imagen": image.asset->url,
    "variantes": variantes[]{
      "tamano": tamano,
      "precio": precio
    }
  }
`);
---

<section id="productos" class="max-w-7xl mx-auto px-4 py-16">
  <div class="text-center mb-16 border-b pb-8">
    <h2 class="text-3xl font-serif font-bold text-gray-800 tracking-widest uppercase">Nuestros Productos</h2>
  </div>

  <!-- Grilla de 4 columnas tipo boutique -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-12">
    {productos.map((prod) => {
      // Prevención de errores si faltan datos en Sanity
      if (!prod.variantes || prod.variantes.length === 0) return null;
      
      // Lógica de Stock: Si isAvailable no está definido (productos viejos), asumimos true
      const disponible = prod.isAvailable !== false; 
      const precioBase = prod.variantes[0].precio;
      const tamanoBase = prod.variantes[0].tamano;

      return (
        <div class={`flex flex-col group ${!disponible ? 'opacity-70' : ''}`}>
          
          <!-- Imagen enlazada al detalle -->
          <a href={`/producto/${prod.slug}`} class="relative block overflow-hidden mb-4 bg-gray-50 aspect-square">
            <img 
              src={prod.imagen} 
              alt={prod.nombre} 
              class={`w-full h-full object-cover transition-transform duration-700 ${disponible ? 'group-hover:scale-105' : ''}`}
            />
            
            {/* Overlay de Agotado */}
            {!disponible && (
              <div class="absolute inset-0 bg-white/30 flex items-center justify-center backdrop-blur-[2px]">
                <span class="bg-gray-900 text-white font-bold tracking-[0.2em] uppercase px-6 py-2 text-xs">
                  Agotado
                </span>
              </div>
            )}
          </a>

          <!-- Información Minimalista -->
          <div class="text-center flex-grow flex flex-col justify-between">
            <div class="px-2">
              <h3 class="text-[11px] font-bold uppercase tracking-[0.15em] text-gray-800 mb-2 leading-relaxed">
                <a href={`/producto/${prod.slug}`} class="hover:text-[#E21A77] transition-colors">
                  {prod.nombre}
                </a>
              </h3>
              <p class="text-lg text-gray-600 mb-4 tracking-wide font-light">
                ${precioBase.toLocaleString('es-AR')}
              </p>
            </div>

            <!-- Botón de bloque completo -->
            <!-- Lógica de Botón Inteligente -->
            {prod.variantes.length > 1 && disponible ? (
              <a 
                href={`/producto/${prod.slug}`}
                class="block w-full py-3.5 text-[10px] font-bold uppercase tracking-[0.2em] transition-all duration-300 bg-[#F19EB8] text-white hover:bg-[#E285A2] shadow-sm text-center"
              >
                Elegir tamaño
              </a>
            ) : (
              <button 
                class={`w-full py-3.5 text-[10px] font-bold uppercase tracking-[0.2em] transition-all duration-300 ${
                  disponible 
                    ? 'bg-[#F19EB8] text-white hover:bg-[#E285A2] shadow-sm' 
                    : 'bg-gray-200 text-gray-400 cursor-not-allowed'
                } btn-agregar`}
                data-id={`${prod.id}-${tamanoBase}`}
                data-nombre={`${prod.nombre} (${tamanoBase})`}
                data-precio={precioBase}
                disabled={!disponible}
              >
                {disponible ? 'Agregar al carrito' : 'Sin Stock'}
              </button>
            )}
          </div>
        </div>
      )
    })}
  </div>
</section>