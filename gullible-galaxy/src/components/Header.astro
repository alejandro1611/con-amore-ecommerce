---
// Header.astro
// Nav estilo claro, con logo tipo cinta y carrito discreto.
// Menú mobile estilo "cortina" que baja dejando ver el fondo.
---

<header class="sticky top-0 z-30 bg-[#FFF5F8]/95 backdrop-blur-sm border-b border-[#F0D9E3]">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center relative">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 shrink-0">
      <img src="/logo.JPG" alt="Con Amore" class="h-10 w-auto rounded-full" />
      <span class="hidden sm:block text-xs uppercase tracking-widest text-gray-500 border-l border-gray-300 pl-2">
        Pastelería Artesanal
      </span>
    </a>

    <!-- Grupo nav + carrito, empujado hacia la derecha -->
    <div class="flex items-center gap-6 md:gap-10 ml-auto">

      <!-- Links para PC -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-700">
        <a href="/" class="hover:text-[#E21A77] transition">Inicio</a>
        <a href="#historia" class="hover:text-[#E21A77] transition">Nuestra Historia</a>
        <a href="#productos" class="hover:text-[#E21A77] transition">Menú</a>
        <a href="#consultas" class="hover:text-[#E21A77] transition">Consultas</a>
        <a href="#ubicacion" class="hover:text-[#E21A77] transition">Ubicación</a>
      </nav>

      <!-- Botón carrito: discreto, se activa cuando hay productos -->
      <button
        id="btn-abrir-carrito"
        aria-label="Abrir carrito"
        class="carrito-toggle relative flex items-center gap-2 px-3 py-2 rounded-full border border-gray-300 text-gray-500 transition-colors duration-300"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span
          id="contador-carrito-nav"
          class="contador-badge text-xs font-bold min-w-[1.25rem] h-5 flex items-center justify-center rounded-full transition-colors duration-300"
        >0</span>
      </button>

      <!-- Botón menú mobile (Hamburguesa) -->
      <button id="btn-menu-mobile" class="md:hidden text-gray-700 p-1" aria-label="Abrir menú">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>

    </div>
  </div>

  <!-- Menú Desplegable para Celulares (Estilo Panel Deslizante de la Referencia) -->
  <!-- Nace justo debajo del header (top-full) y usa max-h-0 para esconderse -->
  <div id="menu-mobile" class="absolute top-full left-0 right-0 bg-[#FFF5F8] border-b border-[#F0D9E3] shadow-2xl overflow-hidden transition-all duration-300 md:hidden z-50" style="max-height: 0px;">
    
    <!-- Enlaces alineados a la izquierda -->
    <nav class="flex flex-col px-8 py-4 gap-4 text-base font-medium text-gray-800">
      <a href="/" class="enlace-mobile hover:text-[#E21A77] transition pb-2 border-b border-gray-200">Inicio</a>
      <a href="#historia" class="enlace-mobile hover:text-[#E21A77] transition pb-2 border-b border-gray-200">Nuestra Historia</a>
      <a href="#productos" class="enlace-mobile hover:text-[#E21A77] transition pb-2 border-b border-gray-200">Menú</a>
      <a href="#consultas" class="enlace-mobile hover:text-[#E21A77] transition pb-2 border-b border-gray-200">Consultas</a>
      <a href="#ubicacion" class="enlace-mobile hover:text-[#E21A77] transition pb-2">Ubicación</a>
    </nav>
  </div>
</header>

<style>
  /* Estado "apagado": carrito vacío */
  .contador-badge {
    background-color: #E5E7EB;
    color: #6B7280;
  }

  /* Estado "activo": cuando el badge tiene data-activo="true" */
  .contador-badge[data-activo="true"] {
    background-color: #E21A77;
    color: white;
  }

  .carrito-toggle[data-activo="true"] {
    border-color: #E21A77;
    color: #E21A77;
  }
</style>

<script>
  // 1. Observer para actualizar el carrito visualmente
  const contador = document.getElementById('contador-carrito-nav');
  const boton = document.getElementById('btn-abrir-carrito');

  function actualizarEstadoVisual() {
    const cantidad = parseInt(contador?.innerText || '0');
    const activo = cantidad > 0;
    contador?.setAttribute('data-activo', activo ? 'true' : 'false');
    boton?.setAttribute('data-activo', activo ? 'true' : 'false');
  }

  if (contador) {
    const observer = new MutationObserver(actualizarEstadoVisual);
    observer.observe(contador, { childList: true, characterData: true, subtree: true });
  }

  // 2. Lógica del menú desplegable tipo cortina
  const btnMenuMobile = document.getElementById('btn-menu-mobile');
  const menuMobile = document.getElementById('menu-mobile');
  const enlacesMobile = document.querySelectorAll('.enlace-mobile');

  function toggleMenuMobile() {
    if (menuMobile) {
      if (menuMobile.style.maxHeight && menuMobile.style.maxHeight !== '0px') {
        // Cierra el menú
        menuMobile.style.maxHeight = '0px';
      } else {
        // Abre el menú calculando su alto real
        menuMobile.style.maxHeight = menuMobile.scrollHeight + 'px';
      }
    }
  }

  btnMenuMobile?.addEventListener('click', toggleMenuMobile);

  // Cierra el menú al hacer clic en un enlace
  enlacesMobile.forEach(enlace => {
    enlace.addEventListener('click', () => {
      if (menuMobile) menuMobile.style.maxHeight = '0px';
    });
  });
</script>