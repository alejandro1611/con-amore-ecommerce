---
---
<section id="ubicacion" class="bg-[#FFF5F8] py-24 px-6 border-t border-pink-100">
  <div class="max-w-6xl mx-auto">
    
    <!-- Encabezados -->
    <div class="text-center mb-16">
      <p class="text-xs font-bold uppercase tracking-widest text-[#D4AF37] mb-3">
        Ubicación & Horarios
      </p>
      <h2 class="text-4xl md:text-5xl font-bold text-[#E21A77] font-serif mt-4 drop-shadow-md">Visitanos en nuestra tienda</h2>
    </div>

    <!-- Contenedor de Mapa y Tarjetas -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
      
      <!-- Mapa -->
      <div class="rounded-xl overflow-hidden shadow-lg border border-gray-100 min-h-[400px]">
        <iframe 
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3633.9283620013803!2d-65.26593592421781!3d-24.383795392322273!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x941baf49cab89493%3A0x3367249300341ce5!2sLaprida%20619%2C%20Y4603%20El%20Carmen%2C%20Jujuy!5e0!3m2!1ses-419!2sar!4v1789843360279!5m2!1ses-419!2sar" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" 
          width="100%" 
          height="100%" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>

      <!-- Tarjetas de Información -->
      <div class="flex flex-col gap-6 justify-center">
        
        <!-- Tarjeta: Dirección -->
        <div class="bg-white p-8 rounded-xl shadow-md border border-gray-100 flex items-center gap-6 hover:shadow-lg transition">
          <div class="bg-[#FFF5F8] p-4 rounded-full text-[#E21A77]">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.243-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          </div>
          <div>
            <h4 class="text-2xl font-serif font-bold text-[#4A2E1B] mb-2">Dirección</h4>
            <p class="text-gray-600 font-medium text-lg leading-relaxed">
              Laprida 619 <br/> 
              <span class="text-gray-500 text-base">El Carmen, Jujuy</span>
            </p>
          </div>
        </div>

        <!-- Tarjeta: Horarios -->
        <div class="bg-white p-8 rounded-xl shadow-md border border-gray-100 flex items-center gap-6 hover:shadow-lg transition">
          <div class="bg-[#FFF5F8] p-4 rounded-full text-[#E21A77]">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
          <div>
            <h4 class="text-2xl font-serif font-bold text-[#4A2E1B] mb-2">Horarios</h4>
            <p class="text-gray-600 font-medium text-lg leading-relaxed">
              Lunes a Domingo <br/> 
              <span class="text-gray-500 text-base">7:30 a 20:00 hs</span>
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>